# 新聞資料來源（公開 WordPress REST API）
WP_API_ORIGIN=https://wp.apdaily.com.tw/

# 部署路徑與公開網址；GitHub Pages 建置腳本已提供預設值。
PAGE_BASE_PATH=/web-tw-apd-live/
PUBLIC_SITE_URL=https://cwinstech2512.github.io/web-tw-apd-live/

# 公開範例站請維持 false。會員金鑰不可提交到 Git。
ENABLE_MEMBER_API=false
MEMBER_API_ORIGIN=
MEMBER_TOKEN_KEY=

# 公開範例站預設不使用原正式站的 Google Analytics。
ENABLE_ANALYTICS=false

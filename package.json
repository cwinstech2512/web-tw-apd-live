{
    "name": "cap-news-web",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev": "npm run build; NODE_ENV=development webpack --config ./webpack.dev.config.js",
        "prod": "npm run build; NODE_ENV=production webpack -p --config ./webpack.prod.config.js",
        "pages": "npm run build && NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production PAGE_BASE_PATH=/web-tw-apd-live/ PUBLIC_SITE_URL=https://cwinstech2512.github.io/web-tw-apd-live/ webpack -p --config ./webpack.pages.config.js",
        "build": "NODE_ENV=development node app/core/_build/index.js || exit",
        "start": "npm run build; NODE_ENV=development webpack-dev-server --devtool eval --progress --colors --config ./webpack.dev.config.js",
        "coverage-report": "NODE_ENV=test nyc report --reporter=lcov --reporter=text --reporter=text-summary",
        "flow-install": "flow-typed install --overwrite",
        "flow-test": "flow || notify -t 'Flow Type' -m 'something mistake'",
        "flow-test:watch": "npm run flow-test; fswatch -e ./**/* -o 1 | xargs -n1 -I{} sh -c 'tput setaf 6; date \"+\n[%m/%d %H:%M:%S]\";tput sgr0; npm run flow-test'",
        "mocha-test": "NODE_ENV=test nyc mocha --opts ./.mochaopts",
        "mocha-test:watch": "NODE_ENV=test mocha --watch --opts ./.mochaopts",
        "precommit": "lint-staged",
        "prettier": "prettier --write \"app/dist/**/*.{js,jsx,css,scss,sass}\"",
        "ssr": "npm run build; NODE_ENV=development webpack-dev-server --devtool eval --progress --colors --config ./webpack.server.js",
        "ssr:server": "npx nodemon --inspect output/server/js/main.js",
        "ssr:build:server": "NODE_ENV=development webpack --config webpack.server.js --watch",
        "ssr:build:client": "NODE_ENV=development webpack --config webpack.client.js --watch"
    },
    "author": "",
    "license": "ISC",
